<%- include('partials/head') %>
<section class="page-hero page-hero-simple"><div><span class="eyebrow">THE COLLECTION MAP</span><h1>Fruit families<br><em>& growing worlds.</em></h1><p>Move through the catalogue by broad fruit groups. These are practical browsing collections, combining botanical relationships with the way fruits are grown, sold and used.</p><a class="button-primary" href="/fruits">Browse the full catalogue <span aria-hidden="true">↗</span></a></div><div class="simple-hero-side"><span class="big-serif-mark">✦</span><span class="side-rule"></span><p>Broad collections<br>One expansive atlas</p></div></section>
<section class="section-block"><div class="section-heading-row"><div><span class="eyebrow">CHOOSE A COLLECTION</span><h2>Find your field of interest</h2><p>Every collection leads to core species, named cultivar entries and related form guides.</p></div></div><div class="family-grid family-grid-large"><% groups.forEach(function(group,index) { %><a class="family-tile family-tile-<%= (index%6)+1 %>" href="/family/<%= group.slug %>"><div class="family-tile-photo"><img src="<%= group.image %>" data-wiki-page="<%= group.examples[0] || 'Fruit' %>" data-image-fallback="<%= group.image %>" alt="Examples from <%= group.name %>" loading="lazy"></div><div class="family-tile-copy"><span class="family-kicker">FRUIT COLLECTION</span><h3><%= group.name %></h3><p><%= group.description %></p><span class="family-tile-bottom">Explore this collection <b aria-hidden="true">↗</b></span><div class="family-examples"><%= group.examples.join(' · ') %></div></div></a><% }); %></div></section>
<%- include('partials/end') %>
