<%- include('partials/head') %>
<section class="page-hero page-hero-simple glossary-hero"><div><span class="eyebrow">REFERENCE DESK</span><h1>Words for the<br><em>fruit world.</em></h1><p>Definitions for botany, propagation, ripening and food handling. Search a term or scan the index.</p><form class="inline-search" action="/glossary" method="get"><label class="sr-only" for="glossarySearch">Search glossary</label><input id="glossarySearch" type="search" name="q" value="<%= q %>" placeholder="Find a term…"><button class="button-primary" type="submit">Search</button></form></div><div class="simple-hero-side"><span class="big-serif-mark">A–Z</span><span class="side-rule"></span><p>Botanical language<br>Made accessible</p></div></section>
<section class="section-block glossary-index"><div class="results-bar"><div><span class="eyebrow">GLOSSARY INDEX</span><h2><%= terms.length %> terms <%= q ? `matching “${q}”` : '' %></h2></div><a class="text-link" href="/glossary">Clear search ↗</a></div><div class="glossary-list"><% terms.forEach(function(term) { %><article class="glossary-row"><div class="glossary-letter"><%= term.term.charAt(0).toUpperCase() %></div><div><h3><a href="/glossary/<%= term.slug %>"><%= term.term %></a></h3><p><%= term.definition %></p></div><a class="glossary-arrow" href="/glossary/<%= term.slug %>" aria-label="Read <%= term.term %> definition">↗</a></article><% }); %></div></section>
<%- include('partials/end') %>
