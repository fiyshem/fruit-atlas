<%- include('partials/head') %>
<section class="page-hero page-hero-simple search-page-hero"><div><span class="eyebrow">SEARCH THE ATLAS</span><h1>Follow a name,<br><em>find a story.</em></h1><p>Search common names, scientific names, groups and origin terms across the full fruit catalogue.</p></div><div class="simple-hero-side"><span class="big-serif-mark">⌕</span><span class="side-rule"></span><p>Names, species<br>and growing terms</p></div></section>
<section class="section-block directory-section"><form class="filter-panel search-filter-panel" action="/search" method="get"><div class="filter-search"><label for="searchPageInput">Your search</label><input id="searchPageInput" type="search" name="q" value="<%= q %>" placeholder="e.g. Alphonso, tropical, Rosaceae…" autofocus></div><div><label for="searchGroup">Fruit group</label><select id="searchGroup" name="group"><option value="">All groups</option><% groups.forEach(function(group) { %><option value="<%= group.name %>" <%= selectedGroup===group.name?'selected':'' %>><%= group.name %></option><% }); %></select></div><div><label for="searchType">Profile type</label><select id="searchType" name="type"><option value="">All types</option><% ['Species profile','Named cultivar','Fruit-form guide'].forEach(function(type) { %><option value="<%= type %>" <%= selectedType===type?'selected':'' %>><%= type %></option><% }); %></select></div><button class="button-primary" type="submit">Search <span aria-hidden="true">↗</span></button></form>
<div class="results-bar"><div><span class="eyebrow">SEARCH RESULTS</span><h2><%= total.toLocaleString('en-US') %> matches</h2></div><% if (q) { %><p>Search term: <strong>“<%= q %>”</strong></p><% } %></div>
<% if (!items.length) { %><div class="empty-state"><h2>No matching fruit profile</h2><p>Try a shorter name or search by a group such as citrus, berries or tropical fruits.</p><a href="/fruits" class="button-primary">Browse the directory</a></div><% } else { %><div class="fruit-card-grid directory-grid"><% items.forEach(function(fruit) { %><%- include('partials/fruit-card', { fruit: fruit }) %><% }); %></div><nav class="pagination" aria-label="Search pages"><% if(page>1){ %><a href="?q=<%= encodeURIComponent(q) %>&group=<%= encodeURIComponent(selectedGroup) %>&type=<%= encodeURIComponent(selectedType) %>&page=<%= page-1 %>">← Previous</a><% } else { %><span></span><% } %><span>Page <strong><%= page %></strong> of <%= totalPages %></span><% if(page<totalPages){ %><a href="?q=<%= encodeURIComponent(q) %>&group=<%= encodeURIComponent(selectedGroup) %>&type=<%= encodeURIComponent(selectedType) %>&page=<%= page+1 %>">Next page →</a><% } else { %><span></span><% } %></nav><% } %>
</section><%- include('partials/end') %>
