<%- include('partials/head') %>
<section class="page-hero page-hero-simple compare-hero"><div><span class="eyebrow">SIDE-BY-SIDE FIELD TOOL</span><h1>Two fruits.<br><em>One clear view.</em></h1><p>Compare profile type, origin, botanical family, flavour, texture, season and common food uses. Use the comparison as a starting point rather than a substitute for cultivar-specific records.</p></div><div class="simple-hero-side"><span class="big-serif-mark">A/B</span><span class="side-rule"></span><p>Similarities<br>and differences</p></div></section>
<section class="section-block compare-section"><form class="compare-controls" action="/compare" method="get"><div><label for="compareLeft">First fruit</label><select id="compareLeft" name="left"><% selectOptions.forEach(function(option) { %><option value="<%= option.slug %>" <%= left.slug===option.slug?'selected':'' %>><%= option.name %> — <%= option.scientificName %></option><% }); %></select></div><span class="compare-vs">VS</span><div><label for="compareRight">Second fruit</label><select id="compareRight" name="right"><% selectOptions.forEach(function(option) { %><option value="<%= option.slug %>" <%= right.slug===option.slug?'selected':'' %>><%= option.name %> — <%= option.scientificName %></option><% }); %></select></div><button type="submit" class="button-primary">Compare profiles <span aria-hidden="true">↗</span></button></form>
<div class="compare-hero-grid"><article class="compare-fruit-heading"><a class="compare-image" href="/fruit/<%= left.slug %>"><img src="<%= left.image %>" data-wiki-page="<%= left.wikiTitle || left.name %>" data-image-fallback="<%= left.image %>" alt="<%= left.name %>" loading="lazy"></a><span class="eyebrow">PROFILE A</span><h2><a href="/fruit/<%= left.slug %>"><%= left.name %></a></h2><p><%= left.scientificName %></p><a class="text-link" href="/fruit/<%= left.slug %>">Open profile ↗</a></article><div class="compare-middle-label">COMPARE<br>THE<br>DETAILS</div><article class="compare-fruit-heading"><a class="compare-image" href="/fruit/<%= right.slug %>"><img src="<%= right.image %>" data-wiki-page="<%= right.wikiTitle || right.name %>" data-image-fallback="<%= right.image %>" alt="<%= right.name %>" loading="lazy"></a><span class="eyebrow">PROFILE B</span><h2><a href="/fruit/<%= right.slug %>"><%= right.name %></a></h2><p><%= right.scientificName %></p><a class="text-link" href="/fruit/<%= right.slug %>">Open profile ↗</a></article></div>
<div class="comparison-table-wrap"><table class="comparison-table"><thead><tr><th>Field note</th><th><%= left.name %></th><th><%= right.name %></th></tr></thead><tbody><tr><th>Profile type</th><td><%= left.recordType %></td><td><%= right.recordType %></td></tr><tr><th>Plant family</th><td><%= left.family %></td><td><%= right.family %></td></tr><tr><th>Fruit group</th><td><%= left.group %></td><td><%= right.group %></td></tr><tr><th>Broad origin</th><td><%= left.origin %></td><td><%= right.origin %></td></tr><tr><th>Flavour</th><td><%= left.flavor %></td><td><%= right.flavor %></td></tr><tr><th>Texture</th><td><%= left.texture %></td><td><%= right.texture %></td></tr><tr><th>Season</th><td><%= left.season %></td><td><%= right.season %></td></tr><tr><th>Food use</th><td><%= left.uses %></td><td><%= right.uses %></td></tr><tr><th>Growing context</th><td><%= left.growing %></td><td><%= right.growing %></td></tr></tbody></table></div><p class="compare-disclaimer">Comparison notes are broad profile descriptions. Exact traits vary with cultivar, local conditions and maturity.</p></section>
<%- include('partials/end') %>
