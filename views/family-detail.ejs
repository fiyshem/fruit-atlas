<%- include('partials/head') %>
<div class="breadcrumb-row"><a href="/">Home</a><span>／</span><a href="/families">Fruit families</a><span>／</span><span><%= group.name %></span></div>
<section class="page-hero page-hero-compact group-hero"><div class="page-hero-copy"><span class="eyebrow">FRUIT COLLECTION</span><h1><%= group.name %></h1><p><%= group.description %> Explore the species, names and form profiles connected to this part of fruit diversity.</p><p class="hero-note-line">A collection of related fruit species and cultivated forms.</p><a href="/families" class="text-link">← All fruit groups</a></div><div class="page-hero-side"><div class="page-hero-side-image"><img src="<%= group.image %>" data-wiki-page="<%= group.examples[0] || 'Fruit' %>" data-image-fallback="<%= group.image %>" alt="<%= group.name %> fruit collection" fetchpriority="high"></div><div class="hero-side-note"><span>IN THIS COLLECTION</span><p><%= group.examples.join(' · ') %></p></div></div></section>
<section class="section-block directory-section"><div class="results-bar"><div><span class="eyebrow">COLLECTION INDEX</span><h2><%= total.toLocaleString('en-US') %> entries</h2></div><p>Showing <strong><%= start %>–<%= end %></strong> of <%= total.toLocaleString('en-US') %></p></div><div class="fruit-card-grid directory-grid"><% items.forEach(function(fruit) { %><%- include('partials/fruit-card', { fruit: fruit }) %><% }); %></div><nav class="pagination" aria-label="Collection pages"><% if (page>1) { %><a href="?page=<%= page-1 %>">← Previous</a><% } else { %><span></span><% } %><span>Page <strong><%= page %></strong> of <%= totalPages %></span><% if (page<totalPages) { %><a href="?page=<%= page+1 %>">Next page →</a><% } else { %><span></span><% } %></nav></section>
<%- include('partials/end') %>
